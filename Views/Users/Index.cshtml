@model IEnumerable<AcxiomCRM.Models.AppUser>
<h2>User management</h2><table class="table"><tr><th>Email</th><th>Role</th><th>Lock/Unlock</th></tr>@foreach(var u in Model){<tr><td>@u.Email</td><td><form asp-action="SetRole" method="post"><input type="hidden" name="id" value="@u.Id"/><select name="role"><option>Admin</option><option>Manager</option><option>SalesExecutive</option></select><button class="btn btn-sm btn-primary">Set role</button></form></td><td><form asp-action="Toggle" method="post"><input type="hidden" name="id" value="@u.Id"/><button class="btn btn-sm btn-outline-danger">Toggle lock</button></form></td></tr>}</table>