<h1>Sales Dashboard</h1>
<form method="get" class="d-flex gap-2 mb-3"><select name="period" class="form-select"><option value="all">All time</option><option value="today">Today</option><option value="week">This Week</option><option value="month">This Month</option><option value="custom">Custom Range</option></select><input type="date" name="from" value="@ViewBag.From" class="form-control"/><input type="date" name="to" value="@ViewBag.To" class="form-control"/><button class="btn btn-primary">Apply</button></form>
<div class="row g-3">@foreach(var card in new[]{("Total Customers",ViewBag.Customers),("Total Leads",ViewBag.Leads),("Open Leads",ViewBag.OpenLeads),("Total Opportunities",ViewBag.Opportunities),("Open Opportunities",ViewBag.Open),("Won Opportunities",ViewBag.Won),("Lost Opportunities",ViewBag.Lost),("Total Pipeline Value",ViewBag.Pipeline)}){<div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted">@card.Item1</div><h2>@card.Item2</h2></div></div></div>}</div>
<p class="mt-3">Weighted open pipeline: @ViewBag.Weighted</p><div class="row"><div class="col-md-4"><h3>Lead Status</h3><canvas id="leadsChart"></canvas></div><div class="col-md-4"><h3>Opportunity Pipeline</h3><canvas id="oppsChart"></canvas></div><div class="col-md-4"><h3>Monthly Sales (Won)</h3><canvas id="salesChart"></canvas></div></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>
const leadData=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LeadStatuses));const oppData=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Stages));const monthData=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Monthly));
const chart=(id,labels,values,type='bar')=>new Chart(document.getElementById(id),{type,data:{labels,datasets:[{label:id,data:values}]}});
const leadLabels=['New','Contacted','Qualified','Lost','Converted'];chart('leadsChart',leadLabels,leadLabels.map(s=>leadData.find(x=>x.name===s)?.count??0),'doughnut');
const oppLabels=['Qualification','Proposal','Negotiation','Won','Lost'];chart('oppsChart',oppLabels,oppLabels.map(s=>oppData.find(x=>x.name===s)?.count??0));
chart('salesChart',monthData.map(x=>`${x.year}-${String(x.month).padStart(2,'0')}`),monthData.map(x=>x.total));
</script>