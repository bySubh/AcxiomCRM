@model AcxiomCRM.Models.Opportunity
<h2>Opportunity</h2><form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label" for="Name">Name</label><input class="form-control" id="Name" name="Name" value="@Model.Name" type="text" /><span class="text-danger" asp-validation-for="Name"></span></div>
<div class="mb-3"><label class="form-label" for="CustomerId">CustomerId</label><input class="form-control" id="CustomerId" name="CustomerId" value="@Model.CustomerId" type="number" /><span class="text-danger" asp-validation-for="CustomerId"></span></div>
<div class="mb-3"><label class="form-label" for="LeadId">LeadId</label><input class="form-control" id="LeadId" name="LeadId" value="@Model.LeadId" type="number" /><span class="text-danger" asp-validation-for="LeadId"></span></div>
<div class="mb-3"><label class="form-label" for="Amount">Amount</label><input class="form-control" id="Amount" name="Amount" value="@Model.Amount" type="number" /><span class="text-danger" asp-validation-for="Amount"></span></div>
<div class="mb-3"><label class="form-label" for="Probability">Probability</label><input class="form-control" id="Probability" name="Probability" value="@Model.Probability" type="number" /><span class="text-danger" asp-validation-for="Probability"></span></div>
<div class="mb-3"><label class="form-label" for="ExpectedCloseDate">ExpectedCloseDate</label><input class="form-control" id="ExpectedCloseDate" name="ExpectedCloseDate" value="@(Model.ExpectedCloseDate.ToString("yyyy-MM-dd"))" type="date" /><span class="text-danger" asp-validation-for="ExpectedCloseDate"></span></div>
<div class="mb-3"><label class="form-label" for="Stage">Stage</label><input class="form-control" id="Stage" name="Stage" value="@Model.Stage" type="text" /><span class="text-danger" asp-validation-for="Stage"></span></div>
<div class="mb-3"><label class="form-label" for="Status">Status</label><input class="form-control" id="Status" name="Status" value="@Model.Status" type="text" /><span class="text-danger" asp-validation-for="Status"></span></div>
<div class="mb-3"><label class="form-label" for="Notes">Notes</label><input class="form-control" id="Notes" name="Notes" value="@Model.Notes" type="text" /><span class="text-danger" asp-validation-for="Notes"></span></div><button class="btn btn-primary">Save</button> <a asp-action="Index">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}