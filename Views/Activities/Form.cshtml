@model AcxiomCRM.Models.Activity
<h2>Activity</h2><form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label" for="Subject">Subject</label><input class="form-control" id="Subject" name="Subject" value="@Model.Subject" type="text" /><span class="text-danger" asp-validation-for="Subject"></span></div>
<div class="mb-3"><label class="form-label" for="ActivityType">ActivityType</label><input class="form-control" id="ActivityType" name="ActivityType" value="@Model.ActivityType" type="text" /><span class="text-danger" asp-validation-for="ActivityType"></span></div>
<div class="mb-3"><label class="form-label" for="Description">Description</label><input class="form-control" id="Description" name="Description" value="@Model.Description" type="text" /><span class="text-danger" asp-validation-for="Description"></span></div>
<div class="mb-3"><label class="form-label" for="ActivityDate">ActivityDate</label><input class="form-control" id="ActivityDate" name="ActivityDate" value="@(Model.ActivityDate.ToString("yyyy-MM-dd"))" type="date" /><span class="text-danger" asp-validation-for="ActivityDate"></span></div>
<div class="mb-3"><label class="form-label" for="CustomerId">CustomerId</label><input class="form-control" id="CustomerId" name="CustomerId" value="@Model.CustomerId" type="number" /><span class="text-danger" asp-validation-for="CustomerId"></span></div>
<div class="mb-3"><label class="form-label" for="LeadId">LeadId</label><input class="form-control" id="LeadId" name="LeadId" value="@Model.LeadId" type="number" /><span class="text-danger" asp-validation-for="LeadId"></span></div>
<div class="mb-3"><label class="form-label" for="Status">Status</label><input class="form-control" id="Status" name="Status" value="@Model.Status" type="text" /><span class="text-danger" asp-validation-for="Status"></span></div><button class="btn btn-primary">Save</button> <a asp-action="Index">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}