@model AcxiomCRM.Models.FollowUp
<h2>FollowUp</h2><form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label" for="Subject">Subject</label><input class="form-control" id="Subject" name="Subject" value="@Model.Subject" type="text" /><span class="text-danger" asp-validation-for="Subject"></span></div>
<div class="mb-3"><label class="form-label" for="CustomerId">CustomerId</label><input class="form-control" id="CustomerId" name="CustomerId" value="@Model.CustomerId" type="number" /><span class="text-danger" asp-validation-for="CustomerId"></span></div>
<div class="mb-3"><label class="form-label" for="LeadId">LeadId</label><input class="form-control" id="LeadId" name="LeadId" value="@Model.LeadId" type="number" /><span class="text-danger" asp-validation-for="LeadId"></span></div>
<div class="mb-3"><label class="form-label" for="OpportunityId">OpportunityId</label><input class="form-control" id="OpportunityId" name="OpportunityId" value="@Model.OpportunityId" type="number" /><span class="text-danger" asp-validation-for="OpportunityId"></span></div>
<div class="mb-3"><label class="form-label" for="FollowUpDate">FollowUpDate</label><input class="form-control" id="FollowUpDate" name="FollowUpDate" value="@(Model.FollowUpDate.ToString("yyyy-MM-dd"))" type="date" /><span class="text-danger" asp-validation-for="FollowUpDate"></span></div>
<div class="mb-3"><label class="form-label" for="FollowUpType">FollowUpType</label><input class="form-control" id="FollowUpType" name="FollowUpType" value="@Model.FollowUpType" type="text" /><span class="text-danger" asp-validation-for="FollowUpType"></span></div>
<div class="mb-3"><label class="form-label" for="Status">Status</label><input class="form-control" id="Status" name="Status" value="@Model.Status" type="text" /><span class="text-danger" asp-validation-for="Status"></span></div>
<div class="mb-3"><label class="form-label" for="Remarks">Remarks</label><input class="form-control" id="Remarks" name="Remarks" value="@Model.Remarks" type="text" /><span class="text-danger" asp-validation-for="Remarks"></span></div><button class="btn btn-primary">Save</button> <a asp-action="Index">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}