<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>AcxiomCRM</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container-fluid"><a class="navbar-brand" asp-controller="Home" asp-action="Index">AcxiomCRM</a><div class="navbar-nav flex-row flex-wrap gap-3"><a class="nav-link" asp-controller="Home">Dashboard</a>@foreach(var name in new[]{"Customers","Leads","Opportunities","FollowUps","Activities"}){<a class="nav-link" href="/@name">@name</a>}@if(User.IsInRole("Admin")||User.IsInRole("Manager")){<a class="nav-link" href="/Reports">Reports</a>}@if(User.IsInRole("Admin")){<a class="nav-link" href="/Users">Users</a><a class="nav-link" href="/Audit">Audit</a>}</div>@if(User.Identity?.IsAuthenticated==true){<form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Logout</button></form>}</div></nav><main class="container py-4">@RenderBody()</main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>