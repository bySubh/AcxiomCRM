@model AcxiomCRM.Models.Lead
<h2>Lead</h2><form method="post" asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label class="form-label" for="Name">Name</label><input class="form-control" id="Name" name="Name" value="@Model.Name" type="text" /><span class="text-danger" asp-validation-for="Name"></span></div>
<div class="mb-3"><label class="form-label" for="Email">Email</label><input class="form-control" id="Email" name="Email" value="@Model.Email" type="email" /><span class="text-danger" asp-validation-for="Email"></span></div>
<div class="mb-3"><label class="form-label" for="Phone">Phone</label><input class="form-control" id="Phone" name="Phone" value="@Model.Phone" type="text" /><span class="text-danger" asp-validation-for="Phone"></span></div>
<div class="mb-3"><label class="form-label" for="CompanyName">CompanyName</label><input class="form-control" id="CompanyName" name="CompanyName" value="@Model.CompanyName" type="text" /><span class="text-danger" asp-validation-for="CompanyName"></span></div>
<div class="mb-3"><label class="form-label" for="Source">Source</label><input class="form-control" id="Source" name="Source" value="@Model.Source" type="text" /><span class="text-danger" asp-validation-for="Source"></span></div>
<div class="mb-3"><label class="form-label" for="Status">Status</label><input class="form-control" id="Status" name="Status" value="@Model.Status" type="text" /><span class="text-danger" asp-validation-for="Status"></span></div>
<div class="mb-3"><label class="form-label" for="Priority">Priority</label><input class="form-control" id="Priority" name="Priority" value="@Model.Priority" type="text" /><span class="text-danger" asp-validation-for="Priority"></span></div>
<div class="mb-3"><label class="form-label" for="ExpectedValue">ExpectedValue</label><input class="form-control" id="ExpectedValue" name="ExpectedValue" value="@Model.ExpectedValue" type="number" /><span class="text-danger" asp-validation-for="ExpectedValue"></span></div>
<div class="mb-3"><label class="form-label" for="Notes">Notes</label><input class="form-control" id="Notes" name="Notes" value="@Model.Notes" type="text" /><span class="text-danger" asp-validation-for="Notes"></span></div><button class="btn btn-primary">Save</button> <a asp-action="Index">Cancel</a></form>
@section Scripts{<partial name="_ValidationScriptsPartial" />}